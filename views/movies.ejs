
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>映画一覧</title>
</head>
<body>
  <h2>映画一覧</h2>
  <table>
    <tr><th>ID</th><th>映画タイトル</th><th>ジャンル</th><th>評価</th></tr>
<% for( let row of data ) { %>
    <tr><td><%= row.id %></td>
    <td><%= row.title %></td>
    <td><%= row.genre %></td></tr>
<% } %>
  </table>
</body>
</html>
